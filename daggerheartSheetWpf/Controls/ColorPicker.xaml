<UserControl x:Class="daggerheartSheetWpf.Controls.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ComboBox x:Name="comboColors"
                  MaxDropDownHeight="260"
                  SelectionChanged="ComboColors_SelectionChanged">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="14"
                                Height="14"
                                Margin="0,0,6,0"
                                BorderBrush="Gray"
                                BorderThickness="1"
                                Background="{Binding Brush}" />
                        <TextBlock Text="{Binding Name}" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="borderPreview"
                    Width="64"
                    Height="64"
                    Margin="0,0,8,0"
                    BorderBrush="Gray"
                    BorderThickness="1" />

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="R" VerticalAlignment="Center" Margin="0,0,4,0" />
                <Slider x:Name="sliderRed"
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="255"
                        IsSnapToTickEnabled="True"
                        TickFrequency="1"
                        VerticalAlignment="Center"
                        ValueChanged="Slider_ValueChanged" />
                <TextBlock Grid.Column="2"
                           Width="28"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Text="{Binding Value, ElementName=sliderRed, StringFormat={}{0:F0}}" />

                <TextBlock Grid.Row="1" Text="G" VerticalAlignment="Center" Margin="0,0,4,0" />
                <Slider x:Name="sliderGreen"
                        Grid.Row="1"
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="255"
                        IsSnapToTickEnabled="True"
                        TickFrequency="1"
                        VerticalAlignment="Center"
                        ValueChanged="Slider_ValueChanged" />
                <TextBlock Grid.Row="1"
                           Grid.Column="2"
                           Width="28"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Text="{Binding Value, ElementName=sliderGreen, StringFormat={}{0:F0}}" />

                <TextBlock Grid.Row="2" Text="B" VerticalAlignment="Center" Margin="0,0,4,0" />
                <Slider x:Name="sliderBlue"
                        Grid.Row="2"
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="255"
                        IsSnapToTickEnabled="True"
                        TickFrequency="1"
                        VerticalAlignment="Center"
                        ValueChanged="Slider_ValueChanged" />
                <TextBlock Grid.Row="2"
                           Grid.Column="2"
                           Width="28"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Text="{Binding Value, ElementName=sliderBlue, StringFormat={}{0:F0}}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
