<UserControl x:Class="daggerheartSheetWpf.Controls.NumericUpDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="46">
    <Border BorderBrush="{x:Static SystemColors.ControlDarkBrush}"
            BorderThickness="1"
            Background="White"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="PART_TextBox"
                     BorderThickness="0"
                     Background="Transparent"
                     TextAlignment="Center"
                     VerticalContentAlignment="Center"
                     Padding="2,0"
                     PreviewTextInput="TextBox_PreviewTextInput"
                     LostFocus="TextBox_LostFocus"
                     PreviewKeyDown="TextBox_PreviewKeyDown" />

            <Grid Grid.Column="1" Width="17">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <RepeatButton x:Name="PART_Up"
                              Content="&#x25B2;"
                              FontSize="7"
                              Padding="0"
                              Focusable="False"
                              Click="Increase_Click" />
                <RepeatButton x:Name="PART_Down"
                              Grid.Row="1"
                              Content="&#x25BC;"
                              FontSize="7"
                              Padding="0"
                              Focusable="False"
                              Click="Decrease_Click" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
