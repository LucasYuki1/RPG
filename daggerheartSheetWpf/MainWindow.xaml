<Window x:Class="daggerheartSheetWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:daggerheartSheetWpf.Controls"
        Title="Ficha de Personagem - Daggerheart"
        Width="960"
        Height="640"
        MinWidth="820"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="CounterLabel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="SheetTextBox" TargetType="TextBox">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Padding" Value="2,3" />
        </Style>

        <Style x:Key="SheetListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Gainsboro" />
            <Setter Property="BorderBrush" Value="{x:Static SystemColors.ControlDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <!-- Mantém a cor escolhida para o item/habilidade e usa uma borda para mostrar a seleção. -->
        <Style x:Key="SheetListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <EventSetter Event="MouseDoubleClick" Handler="ListItem_MouseDoubleClick" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="SelectionBorder"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#FF9E9E9E" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#FF2B579A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="InventoryItemTemplate">
            <Border Background="{Binding Background}" CornerRadius="4" Padding="8,6">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Ver detalhes" Click="DetailsMenuItem_Click" />
                        <Separator />
                        <MenuItem Header="Excluir item" Click="RemoveItemMenuItem_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding DisplayName}"
                               Foreground="{Binding Foreground}"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding DisplayName}" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="i"
                                FontFamily="Georgia"
                                FontStyle="Italic"
                                FontWeight="Bold"
                                ToolTip="Ver detalhes"
                                Style="{StaticResource RowButton}"
                                Click="DetailsButton_Click" />
                        <Button Content="X"
                                FontWeight="Bold"
                                ToolTip="Excluir item"
                                Style="{StaticResource RowButton}"
                                Click="RemoveItemButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SkillTemplate">
            <Border Background="{Binding Background}" CornerRadius="4" Padding="8,6">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Ver detalhes" Click="DetailsMenuItem_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Name}"
                               Foreground="{Binding Foreground}"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Name}" />

                    <Button Grid.Column="1"
                            Content="i"
                            FontFamily="Georgia"
                            FontStyle="Italic"
                            FontWeight="Bold"
                            ToolTip="Ver detalhes"
                            Style="{StaticResource RowButton}"
                            Click="DetailsButton_Click" />
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <TabControl Margin="8">

        <TabItem Header="Atributos e Recursos">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <GroupBox Header="Identidade" Margin="0,0,6,10" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Nome:" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="textBoxName" Grid.Column="1" Style="{StaticResource SheetTextBox}" />

                        <TextBlock Grid.Row="1" Text="Pronomes:" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="textBoxPronouns" Grid.Row="1" Grid.Column="1" Style="{StaticResource SheetTextBox}" />

                        <TextBlock Grid.Row="2" Text="Herança:" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="textBoxHeritage" Grid.Row="2" Grid.Column="1" Style="{StaticResource SheetTextBox}" />

                        <TextBlock Grid.Row="3" Text="Classe:" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="textBoxClass" Grid.Row="3" Grid.Column="1" Style="{StaticResource SheetTextBox}" />

                        <StackPanel Grid.Column="2"
                                    Grid.RowSpan="4"
                                    Margin="16,0,4,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Nível:" Style="{StaticResource CounterLabel}" />
                            <controls:NumericUpDown x:Name="numericLevel"
                                                    Minimum="1"
                                                    Maximum="10"
                                                    Value="1"
                                                    Width="74"
                                                    FontSize="20" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Column="1" Header="Atributos" Margin="6,0,0,10" Padding="8">
                    <UniformGrid Rows="1" Columns="6">
                        <StackPanel Margin="2">
                            <TextBlock Text="Agilidade" Style="{StaticResource CounterLabel}" />
                            <controls:NumericUpDown x:Name="numericAgility" Minimum="1" Maximum="10" Value="1" FontSize="18" />
                            <CheckBox x:Name="checkBoxAgility" HorizontalAlignment="Center" Margin="0,6,0,0" ToolTip="Marcar atributo" />
                        </StackPanel>
                        <StackPanel Margin="2">
                            <TextBlock Text="Força" Style="{StaticResource CounterLabel}" />
                            <controls:NumericUpDown x:Name="numericStrength" Minimum="1" Maximum="10" Value="1" FontSize="18" />
                            <CheckBox x:Name="checkBoxStrength" HorizontalAlignment="Center" Margin="0,6,0,0" ToolTip="Marcar atributo" />
                        </StackPanel>
                        <StackPanel Margin="2">
                            <TextBlock Text="Finesse" Style="{StaticResource CounterLabel}" />
                            <controls:NumericUpDown x:Name="numericFinesse" Minimum="1" Maximum="10" Value="1" FontSize="18" />
                            <CheckBox x:Name="checkBoxFinesse" HorizontalAlignment="Center" Margin="0,6,0,0" ToolTip="Marcar atributo" />
                        </StackPanel>
                        <StackPanel Margin="2">
                            <TextBlock Text="Instinto" Style="{StaticResource CounterLabel}" />
                            <controls:NumericUpDown x:Name="numericInstinct" Minimum="1" Maximum="10" Value="1" FontSize="18" />
                            <CheckBox x:Name="checkBoxInstinct" HorizontalAlignment="Center" Margin="0,6,0,0" ToolTip="Marcar atributo" />
                        </StackPanel>
                        <StackPanel Margin="2">
                            <TextBlock Text="Presença" Style="{StaticResource CounterLabel}" />
                            <controls:NumericUpDown x:Name="numericPresence" Minimum="1" Maximum="10" Value="1" FontSize="18" />
                            <CheckBox x:Name="checkBoxPresence" HorizontalAlignment="Center" Margin="0,6,0,0" ToolTip="Marcar atributo" />
                        </StackPanel>
                        <StackPanel Margin="2">
                            <TextBlock Text="Conhec." Style="{StaticResource CounterLabel}" ToolTip="Conhecimento" />
                            <controls:NumericUpDown x:Name="numericKnowledge" Minimum="1" Maximum="10" Value="1" FontSize="18" />
                            <CheckBox x:Name="checkBoxKnowledge" HorizontalAlignment="Center" Margin="0,6,0,0" ToolTip="Marcar atributo" />
                        </StackPanel>
                    </UniformGrid>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="Defesa" Margin="0,0,6,0" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Evasão" Style="{StaticResource CounterLabel}" />
                            <controls:NumericUpDown x:Name="numericEvasion" Minimum="1" Maximum="10" Value="1" Width="74" FontSize="18" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="Armadura" Style="{StaticResource CounterLabel}" />
                            <controls:NumericUpDown x:Name="numericArmor" Minimum="1" Maximum="10" Value="1" Width="74" FontSize="18" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Pontos de armadura" Style="{StaticResource CounterLabel}" />
                            <controls:NumericUpDown x:Name="numericArmorPoints"
                                                    Minimum="0"
                                                    Maximum="16"
                                                    Value="1"
                                                    Width="74"
                                                    FontSize="18"
                                                    HorizontalAlignment="Center" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Grid.ColumnSpan="3"
                                Background="Silver"
                                CornerRadius="4"
                                Margin="0,12,0,0"
                                Padding="8,6">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Dano&#x0a;menor" TextAlignment="Center" VerticalAlignment="Center" />
                                <controls:NumericUpDown x:Name="numericMajorThreshold"
                                                        Minimum="0"
                                                        Maximum="16"
                                                        Value="1"
                                                        Width="56"
                                                        Margin="10,0"
                                                        VerticalAlignment="Center" />
                                <TextBlock Text="Dano&#x0a;maior" TextAlignment="Center" VerticalAlignment="Center" />
                                <controls:NumericUpDown x:Name="numericSevereThreshold"
                                                        Minimum="0"
                                                        Maximum="16"
                                                        Value="1"
                                                        Width="56"
                                                        Margin="10,0"
                                                        VerticalAlignment="Center" />
                                <TextBlock Text="Dano&#x0a;severo" TextAlignment="Center" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="1" Grid.Column="1" Header="Recursos" Margin="6,0,0,0" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="1" Text="Vida" Style="{StaticResource CounterLabel}" />
                        <TextBlock Grid.Column="2" Text="Estresse" Style="{StaticResource CounterLabel}" />
                        <TextBlock Grid.Column="3" Text="Esperança" Style="{StaticResource CounterLabel}" />

                        <TextBlock Grid.Row="1" Text="Atual:" Style="{StaticResource FieldLabel}" />
                        <controls:NumericUpDown x:Name="numericHealth" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="10" Value="1" Width="64" FontSize="18" Margin="4" />
                        <controls:NumericUpDown x:Name="numericStress" Grid.Row="1" Grid.Column="2" Minimum="1" Maximum="10" Value="1" Width="64" FontSize="18" Margin="4" />
                        <controls:NumericUpDown x:Name="numericHope" Grid.Row="1" Grid.Column="3" Minimum="1" Maximum="10" Value="1" Width="64" FontSize="18" Margin="4" />

                        <TextBlock Grid.Row="2" Text="Máximo:" Style="{StaticResource FieldLabel}" />
                        <controls:NumericUpDown x:Name="numericMaxHealth" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="10" Value="1" Width="64" Margin="4" />
                        <controls:NumericUpDown x:Name="numericMaxStress" Grid.Row="2" Grid.Column="2" Minimum="1" Maximum="10" Value="1" Width="64" Margin="4" />
                        <controls:NumericUpDown x:Name="numericMaxHope" Grid.Row="2" Grid.Column="3" Minimum="1" Maximum="10" Value="1" Width="64" Margin="4" />
                    </Grid>
                </GroupBox>
            </Grid>
        </TabItem>

        <TabItem Header="Inventário e Habilidades">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" MinWidth="250" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <DockPanel Margin="0,0,12,0">
                    <TextBlock DockPanel.Dock="Top" Text="Inventário" Style="{StaticResource SectionTitle}" />

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="buttonAddItem"
                                Content="Adicionar item"
                                Width="130"
                                Height="30"
                                Margin="0,0,8,0"
                                Click="AddItem_Click" />
                        <Button x:Name="buttonRemoveItem"
                                Content="Remover item"
                                Width="130"
                                Height="30"
                                Click="RemoveSelectedItem_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem, ElementName=listBoxInventory}" Value="{x:Null}">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <Grid>
                        <ListBox x:Name="listBoxInventory"
                                 ItemsSource="{Binding Inventory}"
                                 ItemTemplate="{StaticResource InventoryItemTemplate}"
                                 ItemContainerStyle="{StaticResource SheetListItem}"
                                 Style="{StaticResource SheetListBox}"
                                 KeyDown="InventoryList_KeyDown" />

                        <TextBlock Text="Nenhum item no inventário."
                                   Foreground="DimGray"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Inventory.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>

                <DockPanel Grid.Column="1">
                    <TextBlock DockPanel.Dock="Top" Text="Habilidades" Style="{StaticResource SectionTitle}" />

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="buttonAddSkill"
                                Content="Adicionar habilidade"
                                Width="160"
                                Height="30"
                                Click="AddSkill_Click" />
                    </StackPanel>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Header="Classe/Subclasse" Margin="0,0,6,6">
                            <ListBox x:Name="listBoxClassSkills"
                                     ItemsSource="{Binding ClassSkills}"
                                     ItemTemplate="{StaticResource SkillTemplate}"
                                     ItemContainerStyle="{StaticResource SheetListItem}"
                                     Style="{StaticResource SheetListBox}" />
                        </GroupBox>

                        <GroupBox Grid.Column="1" Header="Carta de Domínio" Margin="6,0,0,6">
                            <ListBox x:Name="listBoxDomainSkills"
                                     ItemsSource="{Binding DomainSkills}"
                                     ItemTemplate="{StaticResource SkillTemplate}"
                                     ItemContainerStyle="{StaticResource SheetListItem}"
                                     Style="{StaticResource SheetListBox}" />
                        </GroupBox>

                        <GroupBox Grid.Row="1" Header="Ancestralidade/Comunidade" Margin="0,6,6,0">
                            <ListBox x:Name="listBoxHeritageSkills"
                                     ItemsSource="{Binding HeritageSkills}"
                                     ItemTemplate="{StaticResource SkillTemplate}"
                                     ItemContainerStyle="{StaticResource SheetListItem}"
                                     Style="{StaticResource SheetListBox}" />
                        </GroupBox>

                        <GroupBox Grid.Row="1" Grid.Column="1" Header="Outros" Margin="6,6,0,0">
                            <ListBox x:Name="listBoxOtherSkills"
                                     ItemsSource="{Binding OtherSkills}"
                                     ItemTemplate="{StaticResource SkillTemplate}"
                                     ItemContainerStyle="{StaticResource SheetListItem}"
                                     Style="{StaticResource SheetListBox}" />
                        </GroupBox>
                    </Grid>
                </DockPanel>
            </Grid>
        </TabItem>

    </TabControl>
</Window>
