<Window x:Class="daggerheartSheetWpf.Dialogs.AddSkillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:daggerheartSheetWpf.Controls"
        Title="Adicionar Habilidade"
        Width="640"
        Height="580"
        MinWidth="560"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="SheetComboBox" TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style x:Key="SheetTextBox" TargetType="TextBox">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Padding" Value="2,3" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Nome da habilidade:" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="textBoxName" Style="{StaticResource SheetTextBox}" Grid.Column="1" />

        <TextBlock Grid.Column="2" Text="Fonte:" Style="{StaticResource FieldLabel}" Margin="16,0,8,0" />
        <ComboBox x:Name="comboSource" Style="{StaticResource SheetComboBox}" Grid.Column="3" DisplayMemberPath="Label" />

        <TextBlock Grid.Row="1" Text="Tipo:" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="comboType" Style="{StaticResource SheetComboBox}" Grid.Row="1" Grid.Column="1" />

        <TextBlock Grid.Row="1" Grid.Column="2" Text="Domínio:" Style="{StaticResource FieldLabel}" Margin="16,0,8,0" />
        <ComboBox x:Name="comboDomain" Style="{StaticResource SheetComboBox}" Grid.Row="1" Grid.Column="3" />

        <TextBlock Grid.Row="2" Text="Atributo:" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="comboTrait" Style="{StaticResource SheetComboBox}" Grid.Row="2" Grid.Column="1" />

        <TextBlock Grid.Row="2" Grid.Column="2" Text="Alcance:" Style="{StaticResource FieldLabel}" Margin="16,0,8,0" />
        <ComboBox x:Name="comboRange" Style="{StaticResource SheetComboBox}" Grid.Row="2" Grid.Column="3" />

        <TextBlock Grid.Row="3" Text="Dano:" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="textBoxDamage" Style="{StaticResource SheetTextBox}" Grid.Row="3" Grid.Column="1" />

        <TextBlock Grid.Row="3" Grid.Column="2" Text="Custo de troca:" Style="{StaticResource FieldLabel}" Margin="16,0,8,0" />
        <controls:NumericUpDown x:Name="numericRecallCost"
                                Grid.Row="3"
                                Grid.Column="3"
                                Minimum="0"
                                Maximum="10"
                                Width="80"
                                HorizontalAlignment="Left"
                                Margin="0,4" />

        <TextBlock Grid.Row="4" Grid.ColumnSpan="4" Text="Descrição:" Margin="0,10,0,4" />

        <TextBox x:Name="textBoxDescription" Style="{StaticResource SheetTextBox}"
                 Grid.Row="5"
                 Grid.ColumnSpan="4"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 MinHeight="90" />

        <GroupBox Grid.Row="6"
                  Grid.ColumnSpan="4"
                  Margin="0,12,0,0"
                  Padding="8">
            <GroupBox.Header>
                <CheckBox x:Name="checkBoxCustomColor" Content="Usar cor personalizada" />
            </GroupBox.Header>
            <controls:ColorPicker x:Name="colorPicker"
                                  SelectedColor="LightBlue"
                                  IsEnabled="{Binding IsChecked, ElementName=checkBoxCustomColor}" />
        </GroupBox>

        <StackPanel Grid.Row="7"
                    Grid.ColumnSpan="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Cancelar"
                    Width="96"
                    Height="28"
                    Margin="0,0,8,0"
                    IsCancel="True" />
            <Button Content="Salvar"
                    Width="96"
                    Height="28"
                    IsDefault="True"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
